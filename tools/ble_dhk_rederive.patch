 void sm_set_ir(sm_key_t ir){
     (void)memcpy(sm_persistent_ir, ir, 16);
+    // Experiment: rederive IRK/DHK after application restores a saved IR.
+    // The HCI_STATE_WORKING handler originally derived these from the
+    // bootstrap IR, which may be all zeros. Do not retain that old DHK.
+    if (sm_initialized && hci_get_state() == HCI_STATE_WORKING){
+        dkg_state = DKG_CALC_IRK;
+        sm_trigger_run();
+    }
+}
+
+bool sm_derived_keys_ready(void){
+    return dkg_state == DKG_READY;
 }
 
